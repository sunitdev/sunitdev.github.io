{
  "name": "@sunit/blog",
  "version": "3.0.0",
  "description": "A personal journal about learning, curiosity, and hands-on experiments",
  "private": true,
  "author": "Sunit",
  "license": "ISC",
  "scripts": {
    "dev": "bun run notebooks:prepare && next dev",
    "build": "bun run notebooks:prepare && next build",
    "lint": "eslint .",
    "test": "bun test lib/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "notebooks:prepare": "bun scripts/prepare-notebooks.ts"
  },
  "dependencies": {
    "next": "^15.1.4",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.5.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "@eslint/eslintrc": "^3.3.1"
  }
}
